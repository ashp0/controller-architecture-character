# Copy to .env and fill in. Never commit .env.
#
# Language and vision go through an OpenCode Go subscription
# (OpenAI-compatible API). Get a key at https://opencode.ai.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Any chat model with image input from https://opencode.ai/inference/go/v1/models
LLM_MODEL=glm-5.3-flash

